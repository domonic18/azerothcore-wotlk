# Local build configuration for deploy/build-tcr.sh
# Copy this file to .env and fill in real values.
# .env is gitignored and must NOT be committed.

# Tencent Cloud Container Registry (TCR) credentials
TCR_USERNAME=your_tcr_username
TCR_PASSWORD=your_tcr_password
TCR_NAMESPACE=your_tcr_namespace

# Optional overrides
# REGISTRY=ccr.ccs.tencentyun.com
# IMAGE_NAME=azerothcore-server
# BRANCH=master
# PLATFORM=linux/amd64
# NO_PUSH=1
# SKIP_MODULES=1
